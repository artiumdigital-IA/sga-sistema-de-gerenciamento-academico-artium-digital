{
  "expo": {
    "name": "FIURJ Docente",
    "slug": "fiurj-app-docente",
    "scheme": "fiurjdocente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.fiurj.docente",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "br.edu.fiurj.docente",
      "versionCode": 2,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa de acesso às fotos para anexar a prova corrigida do aluno.",
          "cameraPermission": "O app precisa da câmera para fotografar a prova física corrigida do aluno."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ffc5883d-7554-4081-9c38-9e0f74d2c00e"
      }
    }
  }
}
